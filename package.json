{
  "name": "nodewarden",
  "version": "1.8.5",
  "description": "Minimal Bitwarden-compatible server running on Cloudflare Workers",
  "author": "shuaiplus",
  "license": "LGPL-3.0",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml",
    "dev:kv": "wrangler dev -c wrangler.kv.toml",
    "dev:demo": "vite --config webapp/vite.config.ts --mode demo --host 127.0.0.1 --port 5174",
    "build": "vite build --config webapp/vite.config.ts",
    "build:demo": "vite build --config webapp/vite.config.ts --mode demo && node scripts/pages-spa-redirects.cjs",
    "domains:sync": "node scripts/sync-global-domains.mjs",
    "i18n": "node scripts/i18n-validate.cjs",
    "i18n:validate": "node scripts/i18n-validate.cjs",
    "test:config-compatibility": "tsx --test scripts/config-compatibility.test.ts",
    "test:vault-compatibility": "tsx --tsconfig webapp/tsconfig.json --import ./scripts/offline-workers-loader.mjs --test scripts/vault-compatibility.test.ts",
    "test:web-crypto": "tsx --test scripts/web-crypto-availability.test.ts",
    "test:notifications-security": "tsx --test scripts/notifications-security.test.ts",
    "test:webauthn-mobile": "node --test scripts/webauthn-mobile-connector.test.mjs",
    "test:webauthn-connector": "node --test scripts/webauthn-connector.test.mjs && tsx --test scripts/webauthn-connector-headers.test.ts",
    "test:webauthn-connectors": "node --test scripts/webauthn-mobile-connector.test.mjs scripts/webauthn-connector.test.mjs && tsx --test scripts/webauthn-connector-headers.test.ts",
    "test:mysql-dialect": "tsx --test scripts/mysql-dialect.test.ts scripts/mysql-catalog.test.ts scripts/mysql-backup-ddl.test.ts",
    "test:node-runtime": "node --import ./server/register-cf-stub.mjs --import tsx --test scripts/local-durable-objects.test.ts",
    "test:app-routes": "tsx --test scripts/app-routes.test.ts",
    "test:db-config-save": "tsx --test scripts/db-config-save.test.ts",
    "test:db-promote": "tsx --test scripts/db-config-promote.test.ts",
    "test:db-availability": "tsx --test scripts/db-availability.test.ts",
    "test:db-policy": "tsx --test scripts/db-host-policy.test.ts",
    "test:db-lifecycle": "tsx --test scripts/db-lifecycle.test.ts",
    "test:db-cluster": "tsx --test scripts/db-cluster.test.ts scripts/db-cluster-restart.test.ts",
    "test:db-cluster-sync": "tsx --test scripts/db-cluster-sync.test.ts",
    "test:s3": "tsx --test scripts/backup-s3.test.ts",
    "test:attachments": "node --import ./server/register-cf-stub.mjs --import tsx --test scripts/attachments-fs.test.ts scripts/attachments-blobstore.test.ts scripts/attachments-probe.test.ts",
    "test:http": "node --import ./server/register-cf-stub.mjs --import tsx --test scripts/http-server.test.ts",
    "test:db-sync-gate": "tsx --test scripts/db-sync-gate.test.ts",
    "test:db-cluster:e2e": "tsx scripts/db-cluster-e2e.ts",
    "migrate:d1-to-mysql": "tsx scripts/migrate-d1-to-mysql.ts",
    "start:node": "node --import ./server/register-cf-stub.mjs --import tsx server/index.ts",
    "build:edgeone:pages": "npm run build && node scripts/edgeone-postbuild.mjs",
    "build:edgeone": "npm run build:edgeone:pages && node scripts/build-edgeone.mjs",
    "check:edgeone": "node scripts/build-edgeone.mjs --check",
    "test:edgeone": "node scripts/edgeone-smoke.mjs",
    "test:edgeone:db": "node scripts/edgeone-smoke.mjs --db",
    "deploy": "wrangler deploy",
    "deploy:kv": "node scripts/ensure-kv.cjs && wrangler deploy -c wrangler.kv.toml",
    "deploy:demo": "npm run build:demo && wrangler pages deploy dist --project-name nw-demo"
  },
  "keywords": [
    "bitwarden",
    "vaultwarden",
    "cloudflare",
    "workers",
    "password-manager"
  ],
  "cloudflare": {
    "bindings": {
      "JWT_SECRET": {
        "description": "Use a strong random string (32+ characters recommended)"
      },
      "DB": {
        "description": "D1 database for storing vault data"
      },
      "ATTACHMENTS": {
        "description": "R2 bucket for storing file attachments"
      },
      "ATTACHMENTS_KV": {
        "description": "Optional KV namespace fallback for attachment/send-file storage"
      }
    }
  },
  "overrides": {
    "nanoid": "3.3.18",
    "undici": "8.12.3",
    "@babel/core": ">=7.29.6",
    "esbuild": ">=0.28.1",
    "ws": "8.21.0",
    "sharp": "0.35.5",
    "launch-editor": "2.14.2",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "opencc-js": "^1.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.104.1",
    "@zip.js/zip.js": "^2.23.0",
    "fflate": "^0.8.3",
    "jsqr": "1.4.0",
    "lucide-preact": "^1.51.0",
    "mysql2": "^3.14.0",
    "preact": "^10.29.3",
    "qrcode-generator": "^2.0.4",
    "wouter": "^3.13.0"
  }
}
